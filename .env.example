# Shared base models; by default data/models inside the repo (git-ignored).
# Point it elsewhere only if this disk is short on space.
MODELS_DIR=./data/models

# The connected project's folder for the tool, e.g. E:/Projects/lootlords/art.
# Left empty, the sandbox data/sandbox is connected. After a change: docker compose up -d
PROJECT_DIR=

COMFYUI_PORT=8188
